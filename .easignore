# Source-control metadata is never required by the remote native build.
**/.git/
**/.github/
.git-safety/

# Dependencies and generated output
**/node_modules/
**/.expo/
**/dist/
**/dist-check/
**/web-build/
**/coverage/
**/expo-env.d.ts
**/*.tsbuildinfo
vite.config.js
vite.config.d.ts

# Generated native projects (Expo CNG recreates these during the build)
**/android/
**/ios/
**/.kotlin/
**/*.orig.*

# Local tools and editor state
**/.vscode/
**/.idea/
**/.DS_Store
**/*.log
**/npm-debug.*
**/yarn-debug.*
**/yarn-error.*

# Never upload local environments, signing material, or service credentials.
**/.env
**/.env.*
!**/.env.example
**/*.jks
**/*.keystore
**/*.p8
**/*.p12
**/*.pem
**/*.key
**/*.mobileprovision
**/credentials.json
**/google-services.json
**/GoogleService-Info.plist
**/service-account*.json
.eas/

# Non-production workspace artifacts
deliverables/
outputs/
work/
supabase/.temp/
supabase/.branches/

# Keep package.json, pnpm-lock.yaml, pnpm-workspace.yaml, apps/mobile,
# packages/domain, and supabase. EAS needs the complete production graph.
