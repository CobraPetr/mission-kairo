# Dependencies and generated output
node_modules/
.expo/
dist/
dist-check/
web-build/
coverage/
expo-env.d.ts
*.tsbuildinfo

# Generated native projects (Expo CNG recreates these during the build)
/android/
/ios/
.kotlin/
*.orig.*

# Local tools and editor state
.vscode/
.idea/
.DS_Store
*.log
npm-debug.*
yarn-debug.*
yarn-error.*

# Source-control and CI metadata are not required in a native build archive
.git/
.github/

# Never upload local environments, signing material, or service credentials
.env
.env.*
!.env.example
*.jks
*.keystore
*.p8
*.p12
*.pem
*.key
*.mobileprovision
credentials.json
google-services.json
GoogleService-Info.plist

# Workspace-only artifacts outside the application source. These paths are
# harmless in a standalone app archive and apply when EAS archives the full
# monorepo.
deliverables/
outputs/
work/
dist/

# Do not add ignore rules for package.json, pnpm-lock.yaml,
# pnpm-workspace.yaml, apps/mobile, or packages/domain. EAS needs the complete
# workspace graph for @winter-arc/domain to resolve.
