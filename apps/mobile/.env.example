# Only EXPO_PUBLIC_ values may be read by the mobile application.
# These example values are intentionally non-functional.
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-public-client-key
EXPO_PUBLIC_REVENUECAT_IOS_KEY=your-public-ios-sdk-key
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=your-public-android-sdk-key
